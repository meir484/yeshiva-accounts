rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // החליפו את שתי הכתובות (באותיות קטנות) בכתובות האמיתיות שלכם.
    function signedIn() { return request.auth != null; }
    function isOwner()  { return signedIn() && request.auth.token.email == 'OWNER@example.com'; }
    function isMember() { return signedIn() && request.auth.token.email in ['OWNER@example.com', 'BOSS@example.com']; }

    match /ledger/{doc} {
      allow read: if isMember();
      allow write: if isOwner();
    }
    match /receipts/{id} {
      allow read: if isMember();
      allow write: if isOwner();
    }
    match /notes/{note} {
      allow read, create: if isMember();
      allow delete: if isOwner();
    }
  }
}
